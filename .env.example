# Copy to .env (never commit .env).

DB_PASSWORD=change-me

# SPEC §6 hard caps. The gateway refuses to start without them; changing them requires a redeploy.
HARD_MAX_SUBSCRIPTIONS_PER_DAY=6
HARD_MAX_PER_SUBSCRIPTION_USDT=1000
HARD_MAX_TOTAL_USDT=5000

# Dashboard is bound to this address; use your LAN/VPN IP to reach it from other devices.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8081

# --- Not read by any service yet; wired in as the milestones land. ---

# Tokens the worker and backtester use against the gateway (SPEC §9, M1).
WORKER_TOKEN=
BACKTESTER_TOKEN=

# Binance self-generated Ed25519 key (SPEC §13, M0). The private key goes in
# secrets/binance_private_key.pem, never here.
BINANCE_API_KEY=
# Optional: tunnel all Binance traffic through a static-IP proxy (SPEC §13).
BINANCE_HTTPS_PROXY=

# Telegram approval channel (SPEC §12, M4).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
